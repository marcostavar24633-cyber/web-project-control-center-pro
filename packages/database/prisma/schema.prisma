generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnvironmentType {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

enum AuditStatus {
  QUEUED
  RUNNING
  PASSED
  WARNING
  FAILED
  CANCELLED
}

enum CheckStatus {
  PASSED
  WARNING
  FAILED
  SKIPPED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  NONE
}

enum UserRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  displayName  String?
  role         UserRole        @default(OWNER)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  memberships  ProjectMember[]
  auditLogs    AuditLog[]
  @@index([isActive])
}

model ProjectMember {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      UserRole @default(OPERATOR)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([userId, projectId])
  @@index([projectId, role])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
  @@index([resource, resourceId, createdAt])
}

model Project {
  id           String        @id @default(cuid())
  name         String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  monitoringEnabled Boolean  @default(false)
  monitoringIntervalMinutes Int @default(60)
  nextAuditAt DateTime?
  lastMonitorAt DateTime?
  environments Environment[]
  audits       AuditJob[]
  monitorEvents MonitorEvent[]
  members      ProjectMember[]
}

model Environment {
  id        String          @id @default(cuid())
  name      String
  url       String
  type      EnvironmentType @default(PRODUCTION)
  projectId String
  createdAt DateTime        @default(now())
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  audits    AuditJob[]
  @@index([projectId])
}

model AuditJob {
  id            String       @id @default(cuid())
  status        AuditStatus  @default(QUEUED)
  trigger       String       @default("MANUAL")
  commitSha     String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  projectId     String
  environmentId String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment   Environment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  checks        AuditCheck[]
  @@index([projectId, createdAt])
  @@index([status])
}

model AuditCheck {
  id         String      @id @default(cuid())
  checkKey   String
  category   String
  name       String
  status     CheckStatus
  severity   Severity    @default(NONE)
  message    String
  details    Json?
  durationMs Int?
  checkedAt  DateTime    @default(now())
  auditJobId String
  auditJob   AuditJob    @relation(fields: [auditJobId], references: [id], onDelete: Cascade)
  @@index([auditJobId])
}

model MonitorEvent {
  id        String   @id @default(cuid())
  type      String
  severity  String   @default("INFO")
  title     String
  message   String
  createdAt DateTime @default(now())
  readAt    DateTime?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([projectId, createdAt])
}
